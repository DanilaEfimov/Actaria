/**
 *  @file operator.ser
 *  @version Act_1_0
 */


#ifndef ASSIGNMENTOPERATOR_SER
#define ASSIGNMENTOPERATOR_SER

#include "Entities/Operators/assignmentoperator.h"
#include "utils.h"

namespace abi {

/**
 * @brief The entity_traits class
 * byte and words measuring traits for Entity
 */
template<>
struct entity_traits<AssignmentOperator, abi::Version::Act_1_0> {
    static constexpr bool is_fixed = true;
    static constexpr int minimum_bytes = 0;
    static constexpr int maximum_bytes = minimum_bytes;

    static constexpr const char* name = "AssignmentOperator";
    static constexpr int minimum_words = 0;
    static constexpr int maximum_words = minimum_words;
};

/**
 * @brief The Writer class
 * version generalized write interface
 */
template<>
struct Writer<AssignmentOperator, abi::Version::Act_1_0> {
    static void write(QDataStream& out, const AssignmentOperator& o) {
        out << o.lvalue;
        writeValue(out, o.rvalue);
    }

    static void write(StringListCursor& out, const AssignmentOperator& o) {
        out.append(QString::number(o.lvalue));
        writeValue(out, o.rvalue);
    }
};

/**
 * @brief The Reader class
 * version generalized read interface
 */
template<>
struct Reader<AssignmentOperator, abi::Version::Act_1_0> {
    static void read(QDataStream& in, AssignmentOperator& o) {
        in >> o.lvalue;
        readValue(in, o.rvalue);
    }

    static void read(StringListCursor& in, AssignmentOperator& o) {
        o.lvalue = static_cast<Entity::id_type>(in.peek().toLongLong());
        readValue(in, o.rvalue);
    }
};

}   // namespace abi

#endif  // ASSIGNMENTOPERATOR_SER
