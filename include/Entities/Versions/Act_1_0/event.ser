/**
 *  @file event.ser
 *  @version Act_1_0
 */


#ifndef EVENT_SER
#define EVENT_SER

#include "Entities/event.h"
#include "Entities/Operators/operator.h"
#include "Entities/trigger.h"

namespace abi {

/**
 * @brief The entity_traits class
 * byte and words measuring traits for Entity
 */
template<>
struct entity_traits<Event, abi::Version::Act_1_0> {
    static constexpr bool is_fixed = true;
    static constexpr int minimum_bytes = 0;
    static constexpr int maximum_bytes = minimum_bytes;

    static constexpr const char* name = "Event";
    static constexpr int minimum_words = 0;
    static constexpr int maximum_words = minimum_words;
};

/**
 * @brief The Writer class
 * version generalized write interface
 */
template<>
struct Writer<Event, abi::Version::Act_1_0> {
    static void write(QDataStream& out, const Event& e) {
        out << e.returned
            << static_cast<int>(e.operators.size());
        for(int i = 0; i < e.operators.size(); i++){
            fix::write(out, *e.operators[i]);
        }
    }

    static void write(StringListCursor& out, const Event& e) {
        out.append(entity_traits<Event, EngineInfo::defaultVersion>::name);
        out.append(e.returned ? TRUE_S : FALSE_S);
        out.append(QString::number(e.operators.size()));
        for(int i = 0; i < e.operators.size(); i++){
            fix::write(out, *e.operators[i]);
        }
    }
};

/**
 * @brief The Reader class
 * version generalized read interface
 */
template<>
struct Reader<Event, abi::Version::Act_1_0> {
    static void read(QDataStream& in, Event& e) {
        in >> e.returned;

        int size;
        in >> size;
        for(int i = 0; i < e.operators.size(); i++){
            fix::read(in, *e.operators[i]);
        }
    }

    static void read(StringListCursor& in, Event& e) {
        e.returned = in.peek() == TRUE_S;

        int size = in.next().toInt();
        for(int i = 0; i < size; i++){
            fix::read(in, *e.operators[i]);
        }

        in.skip();
    }
};

}   // namespace abi

#endif  // EVENT_SER
