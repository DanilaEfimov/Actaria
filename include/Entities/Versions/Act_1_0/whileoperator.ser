 * byte and words measuring traits for Entity
 */
template<>
struct entity_traits<WhileOperator, abi::Version::Act_1_0> {
    static constexpr bool is_fixed = true;
    static constexpr int minimum_bytes = 0;
    static constexpr int maximum_bytes = minimum_bytes;

    static constexpr const char* name = "WhileOperator";
    static constexpr int minimum_words = 0;
    static constexpr int maximum_words = minimum_words;
};

