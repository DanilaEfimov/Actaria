/**
 *  @file returnoperator.ser
 *  @version Act_1_0
 */


#ifndef RETURNOPERATOR_SER
#define RETURNOPERATOR_SER

#define MAGIC_MARK

#include "Entities/Operators/returnoperator.h"
#include "stringlistcursor.h"
#include "datastreamcursor.h"


namespace abi {

/**
 * @brief The entity_traits class
 * byte and words measuring traits for Entity
 */
template<>
struct entity_traits<ReturnOperator, abi::Version::Act_1_0> {
    static constexpr bool is_fixed = true;
    static constexpr int minimum_bytes = 0;
    static constexpr int maximum_bytes = minimum_bytes;

    static constexpr const char* name = "ReturnOperator";
    static constexpr int minimum_words = 0;
    static constexpr int maximum_words = minimum_words;
};

/**
 * @brief The Writer class
 * version generalized write interface
 */
template<>
struct Writer<ReturnOperator, abi::Version::Act_1_0> {
    static void write(DataStreamCursor& out, [[gnu::unused]] const ReturnOperator& o) {
        out << ReturnOperator::magic_mark;
    }

    static void write(StringListCursor& out, [[gnu::unused]] const ReturnOperator& o) {
        out.append(entity_traits<ReturnOperator, abi::Version::Act_1_0>::name);
    }
};

/**
 * @brief The Reader class
 * version generalized read interface
 */
template<>
struct Reader<ReturnOperator, abi::Version::Act_1_0> {
    static void read(DataStreamCursor& in, [[gnu::unused]] ReturnOperator& o) {
        in.skipRawData(sizeof(ReturnOperator::magic_mark));
    }

    static void read(StringListCursor& in, [[gnu::unused]] ReturnOperator& o) {
        in.skip();
    }
};

}   // namespace abi

#endif  // RETURNOPERATOR_SER
