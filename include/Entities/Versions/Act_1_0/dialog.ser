#ifndef DIALOG_SER
#define DIALOG_SER

#include "Entities/dialog.h"
#include "datastreamcursor.h"

#include "context.ser"
#include "dialognode.ser"
#include "event.ser"

namespace abi {

/**
 * @brief The entity_traits class
 * byte and words measuring traits for Entity
 */
template<>
struct entity_traits<Dialog, abi::Version::Act_1_0> {
    static constexpr bool is_fixed = false;
    static constexpr int minimum_bytes = minimumQStringSize;
    static constexpr int maximum_bytes = unlimited;

    static constexpr const char* name = "Dialog";
    static constexpr int minimum_words = 3;
    static constexpr int maximum_words = minimum_words;
};

/**
 * @brief The Writer class
 * version generalized conetext var write interface
 */
template<>
struct Writer<Dialog, abi::Version::Act_1_0> {
    static void write(DataStreamCursor& out, const Dialog& c) {
        abi::write<Context, abi::Version::Act_1_0>(out, c.context);

        qsizetype events = c.events.size();
        out << static_cast<qsizetype>(events);
        for(qsizetype i = 0; i < events; i++) {
            abi::write<Event, abi::Version::Act_1_0>(out, c.events[i]);
        }

        qsizetype nodes = c.nodes.size();
        out << static_cast<qsizetype>(nodes);
        for(qsizetype i = 0; i < nodes; i++) {
            abi::write<DialogNode, abi::Version::Act_1_0>(out, c.nodes[i]);
        }
    }

    static void write(StringListCursor& out, const Dialog& c) {
        out.append(entity_traits<Dialog, abi::Version::Act_1_0>::name);

        qsizetype events = c.events.size();
        out.append(QString::number(events));
        for(qsizetype i = 0; i < events; i++) {
            abi::write<Event, abi::Version::Act_1_0>(out, c.events[i]);
        }

        qsizetype nodes = c.nodes.size();
        out.append(QString::number(nodes));
        for(qsizetype i = 0; i < nodes; i++) {
            abi::write<DialogNode, abi::Version::Act_1_0>(out, c.nodes[i]);
        }
    }
};

/**
 * @brief The Reader class
 * version generalized read interface
 */
template<>
struct Reader<Dialog, abi::Version::Act_1_0> {
    static void read(DataStreamCursor& in, Dialog& c) {
        abi::read<Context, abi::Version::Act_1_0>(in, c.context);

        qsizetype events = 0;
        in >> events;
        for(qsizetype i = 0; i < events; i++) {
            abi::write<Event, abi::Version::Act_1_0>(in, c.events[i]);
        }

        qsizetype nodes = 0;
        in >> nodes;
        for(qsizetype i = 0; i < nodes; i++) {
            abi::write<DialogNode, abi::Version::Act_1_0>(in, c.nodes[i]);
        }
    }

    static void read(StringListCursor& in, Dialog& c) {
        abi::read<Context, abi::Version::Act_1_0>(in, c.context);

        qsizetype events = static_cast<qsizetype>(in.peek().toULongLong());
        for(qsizetype i = 0; i < events; i++) {
            abi::write<Event, abi::Version::Act_1_0>(in, c.events[i]);
        }

        qsizetype nodes = static_cast<qsizetype>(in.peek().toULongLong());
        for(qsizetype i = 0; i < nodes; i++) {
            abi::write<DialogNode, abi::Version::Act_1_0>(in, c.nodes[i]);
        }
    }
};

}   // namespace abi

#endif // DIALOG_SER
